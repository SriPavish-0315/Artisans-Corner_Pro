# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=https://artisans-corner-pro.vercel.app

# Database
MONGO_URI=mongodb+srv://your_db_user:your_db_password@cluster.mongodb.net/artisanscorner

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Stripe Payment Gateway API Credentials
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Cloudinary CDN Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-16-digit-gmail-app-password
EMAIL_FROM="Artisan's Corner <no-reply@artisanscorner.com>"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-16-digit-gmail-app-password
FROM_NAME="Artisan's Corner"
FROM_EMAIL=no-reply@artisanscorner.com
